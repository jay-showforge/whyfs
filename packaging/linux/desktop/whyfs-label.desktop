[Desktop Entry]
Type=Application
Name=WhyFS label
Comment=Why does this file exist? Open its WhyFS provenance label
Exec=whyfs ui --file %f
Icon=system-search
Terminal=false
NoDisplay=true
MimeType=application/octet-stream;text/plain;application/x-executable;application/x-sharedlib;application/json;application/zip;application/pdf;image/png;image/jpeg;text/x-python;text/x-csrc;text/javascript;text/html;
