#!/bin/sh
# Stop a running WhyFS service before its files are replaced (upgrade), and wait until it has
# stopped: stopping drains the collector, so everything it received is stored.  The provenance
# store is never touched.
LABEL=org.tenzorpipe.whyfs
launchctl bootout system/$LABEL 2>/dev/null || true
i=0
while launchctl print system/$LABEL >/dev/null 2>&1 && [ $i -lt 150 ]; do sleep 1; i=$((i + 1)); done
exit 0
