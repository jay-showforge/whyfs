/dist-packages/whyfs/ui.html\n/usr/lib/python3/dist-packages/whyfs/ui.py\n/usr/lib/python3/dist-packages/whyfs/winsecurity.py\n/usr/lib/python3/dist-packages/whyfs/winsvc.py\n/usr/lib/whyfs\n/usr/lib/whyfs/scope-default.conf\n/usr/lib/whyfs/whyfs-collect\n/usr/lib/whyfs/whyfs-collect.source-sha256\n/usr/share\n/usr/share/applications\n/usr/share/applications/whyfs-label.desktop\n/usr/share/applications/whyfs.desktop\n/usr/share/doc\n/usr/share/doc/whyfs\n/usr/share/doc/whyfs/README.md\n/usr/share/doc/whyfs/copyright\n/usr/share/kio\n/usr/share/kio/servicemenus\n/usr/share/kio/servicemenus/whyfs.desktop\n/usr/share/kservices5\n/usr/share/kservices5/ServiceMenus\n/usr/share/kservices5/ServiceMenus/whyfs.desktop\n/usr/share/nautilus-python\n/usr/share/nautilus-python/extensions\n/usr/share/nautilus-python/extensions/whyfs_nautilus.py\n/usr/share/nemo\n/usr/share/nemo/actions\n/usr/share/nemo/actions/whyfs-history.nemo_action\n/usr/share/nemo/actions/whyfs-impact.nemo_action\n/usr/share/nemo/actions/whyfs-why.nemo_action\n/etc/whyfs:\ntotal 12\ndrwxr-xr-x  2 root root 4096 Sep 29 09:19 .\ndrwxr-xr-x 96 root root 4096 Sep 29 12:57 ..\n-rw-r--r--  1 root root  461 Sep 27 17:13 scope.conf\nls: cannot open directory '/usr/lib/whyfs': Permission denied\nls: cannot open directory '/var/lib/whyfs': Permission denied\n","exit_code":2,"status":"failed"}}
