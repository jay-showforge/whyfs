appear inside ChatGPT Work mode.\",\"mimeType\":\"mcp/plugin\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa\",\"plugin_name\":\"work-pets\",\"plugin_release_id\":\"pluginrel_6a605738d6308191b431b6477919eafb\",\"plugin_release_version\":\"0.1.6\",\"apps\":[\"app://connector_openai_chatgpt_pets\"],\"skills\":[\"skill://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/create-pet\",\"skill://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/pets\",\"skill://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/update-pet\"],\"requires_executor\":true,\"mcp_servers\":[],\"contents\":[\"bundle\"],\"bundle\":\"plugin://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/bundle\"}},{\"server\":\"codex_apps\",\"uri\":\"plugin://plugin_connector_1p_b3438d6beb9081918fba3625bc988128\",\"name\":\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128\",\"title\":\"Plugin Management\",\"description\":\"Discover relevant plugins and manage app connections, permissions, and dependencies.\",\"mimeType\":\"mcp/plugin\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128\",\"plugin_name\":\"plugin-management\",\"plugin_release_id\":\"pluginrel_6a7e9f7d0ef08191b97b213bb9e118ef\",\"plugin_release_version\":\"0.1.0\",\"apps\":[\"app://connector_openai_plugin_management\"],\"skills\":[\"skill://plugin_connector_1p_b3438d6beb9081918fba3625bc988128/plugin-management\"],\"requires_executor\":false,\"mcp_servers\":[],\"contents\":[\"bundle\"],\"bundle\":\"plugin://plugin_connector_1p_b3438d6beb9081918fba3625bc988128/bundle\"}},{\"server\":\"codex_apps\",\"uri\":\"plugin://plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"name\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"title\":\"Sites\",\"description\":\"Build and deploy websites with Sites. Use of Sites is subject to the ChatGPT Sites Terms (https://openai.com/policies/chatgpt-sites-terms/), and you are responsible for your website content.\",\"mimeTy